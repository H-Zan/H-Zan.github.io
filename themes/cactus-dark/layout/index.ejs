<section id="about">
  <% if (config.description) { %>
    <%- markdown(config.description) %>
  <% } %>
  <p style="display: inline">
    <% if (theme.customize.social_links) { %>
      Find me on
      <ul id="sociallinks">
        <% for(var i in theme.customize.social_links) { %>
          <li><a class="icon" target="_blank" href="<%- url_for(theme.customize.social_links[i]) %>" title="<%= i %>"><i class="fa fa-<%= i %>"></i></a></li>
        <% } %>
      </ul>.
    <% } %>
  </p>
</section>

<%
  var colCounts = {};
  var latestNews = null;
  site.pages.forEach(function(p) {
    if (p.column) {
      colCounts[p.column] = (colCounts[p.column] || 0) + 1;
    }
    if (p.column === 'ai-news') {
      if (!latestNews || new Date(p.date) > new Date(latestNews.date)) latestNews = p;
    }
  });
  var homeColumns = [
    { id: 'agent-playbook', href: '/agent-playbook/', badge: 'AGENT PLAYBOOK', accent: 'cyan', title: 'Agent 使用技巧 · 提效与前沿', desc: 'Antigravity CLI (agy) / Claude Code / Codex（Mac & Win），四大思维与 2026 前沿风向。' },
    { id: 'agent-projects', href: '/agent-projects/', badge: 'AGENT PROJECTS', accent: 'rose', title: 'Agent 实战项目工坊 · 双轨实操', desc: '3 大硬核项目（全栈 0→1 / 手搓 Harness / 老仓库重构），⚡ 速通版 + 🧱 基础分步版。' },
    { id: 'ai-tutorials', href: '/ai-tutorials/', badge: 'AI TUTORIALS', accent: 'emerald', title: 'AI 教程专栏 · 四级体系', desc: '初级 / 中级 / 高级 / 究极全链路深度图文，中英双语一键切换。' },
    { id: 'python-tutorials', href: '/python-tutorials/', badge: 'PYTHON', accent: 'gold', title: 'Python 教程 · 现代工程', desc: '现代语法与类型注解、uv & asyncio 异步工程、FastAPI + Pydantic 实战。' },
    { id: 'python-ai-practice', href: '/python-ai-practice/', badge: 'PYTHON + AI', accent: 'violet', title: 'Python AI 实践 · 代码落地', desc: '统一 LLM SDK 结构化抽取、手写混合检索 RAG、可控 Agent 与自动化 Eval。' },
    { id: 'pg-tutorials', href: '/pg-tutorials/', badge: 'POSTGRESQL', accent: 'blue', title: 'PostgreSQL 数据库教程', desc: 'CTE 与窗口函数、索引/EXPLAIN/MVCC 调优、JSONB + pgvector 混合向量检索。' },
    { id: 'ai-news', href: '/ai-news/', badge: 'AI HOT EVENTS', accent: 'orange', title: 'AI 热点大事件 · 前沿雷达', desc: latestNews ? latestNews.title : '追踪全球 AI 重大模型、政策与工程突破，一手信源核验。' }
  ];
%>
<section id="columns" class="column-showcase">
  <span class="h1"><a href="<%- url_for('/columns/') %>">Columns · 专栏</a></span>
  <div class="showcase-grid">
    <% homeColumns.forEach(function(c) { %>
      <a class="showcase-card accent-hover-<%= c.accent %>" href="<%- url_for(c.href) %>">
        <div class="showcase-head">
          <span class="showcase-badge badge-<%= c.accent %>"><%= c.badge %></span>
          <span class="showcase-stat">
            <% if (c.id === 'ai-news' && latestNews) { %>
              最新 <%= date(latestNews.date, 'YYYY-MM-DD') %>
            <% } else { %>
              <%= colCounts[c.id] || 0 %> 篇
            <% } %>
          </span>
        </div>
        <div class="showcase-title"><%= c.title %></div>
        <p class="showcase-desc"><%= c.desc %></p>
      </a>
    <% }); %>
  </div>
</section>

<section id="writing">
  <span class="h1"><a href="<%- url_for("archives") %>">Writing</a></span>
  <ul class="post-list">
    <% if (theme.customize.show_all_posts) { %>
      <% var show_posts = page.posts.sort('date', 'desc') %>
    <% } else { %>
      <% var show_posts = site.posts.sort('date', 'desc').limit(theme.customize.post_count || 5) %>
    <% } %>
    <% show_posts.each(function(post, i){ %>
      <li class="post-item">
        <%- partial('_partial/post/date', { post: post, class_name: 'meta' }) %>
        <span><%- partial('_partial/post/title', { post: post, index: true, class_name: '' }) %></span>
      </li>
    <% }); %>
  </ul>
  <% if (theme.customize.show_all_posts) { %>
    <%- partial('_partial/pagination') %>
  <% } %>
</section>

<% if (site.data.projects) { %>
<section id="projects">
  <span class="h1"><a href="<%- url_for(theme.projects_url) %>">Projects</a></span>
  <ul class="project-list">
    <% for(var obj in site.data.projects){ %>
      <li class="project-item">
        <a href="<%= site.data.projects[obj].url %>"><%= site.data.projects[obj].name %></a>: <%= site.data.projects[obj].desc %>
      </li>
    <% } %>
  </ul>
</section>
<% } %>
